{
  "name": "inkrunner",
  "version": "1.0.0",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "server": "node server/server.mjs",
    "build": "tsc && vite build",
    "start": "npm run build && node server/server.mjs",
    "preview": "vite preview",
    "check": "tsc && node tools/check-art.mjs",
    "test": "node --test tools/tests/",
    "ios:sync": "npm run build && cap sync ios && node tools/ios-normalize.mjs",
    "ios:open": "cap open ios",
    "ios:run": "npm run ios:sync && cap run ios",
    "test:ios": "node tools/ios-smoke.mjs",
    "ios:credentials": "python tools/ios-credentials.py",
    "ramp": "node tools/ramp.mjs",
    "route:first": "node tools/routes/first.mjs",
    "test:engine": "flock /tmp/inkrunner-browser.lock node tools/tests/engine.shot.mjs",
    "test:raijin-flash": "flock /tmp/inkrunner-browser.lock node tools/tests/raijin-flash.shot.mjs"
  },
  "type": "module",
  "devDependencies": {
    "@capacitor/cli": "8.4.3",
    "puppeteer-core": "^25.12.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.1"
  },
  "private": true,
  "dependencies": {
    "@capacitor/app": "^8.1.2",
    "@capacitor/core": "^8.5.2",
    "@capacitor/filesystem": "^8.1.3",
    "@capacitor/ios": "^8.5.2",
    "@capacitor/preferences": "^8.0.1",
    "@capacitor/share": "^8.0.3",
    "@fontsource/shippori-mincho": "^5.3.0",
    "@fontsource/yuji-syuku": "^5.3.0"
  }
}
